,"error":null,"adsUnitLeaderboard":"","adsUnitInread":"","adsUnitRectangle":"","totalPages":null,"gtm":null},"newsProgram2021":{"fetching":false,"data":null,"error":null,"adsUnitLeaderboard":"","adsUnitInread":"","adsUnitRectangle":"","prerollUrl":"","dataFirstHighlight":null,"totalPages":null,"dfp_key":"","dfp_value":"","ga_screen_name":"","gtm":null},"newsSearch2021":{"fetching":false,"data":null,"error":null,"adsUnitLeaderboard":"","adsUnitRectangle":""},"newsExclusive2021":{"fetching":false,"data":null,"error":null,"adsUnitLeaderboard":"","adsUnitInread":"","adsUnitRectangle":"","prerollUrl":"","dfp_key":"","dfp_value":"","ga_screen_name":"","gtm":null},"getExclusiveDetail2021":{"fetching":false,"data":null,"error":null,"adsUnitLeaderboard":"","adsUnitInread":"","adsUnitRectangle":"","prerollUrl":"","dfp_key":"","dfp_value":"","ga_screen_name":"","gtm":null},"userAddressesReducer":{"province":[],"provice_loading":false,"district":[],"district_loading":false,"subdistrict":[],"subdistrict_loading":false},"sportGameReducer":{"sportGameByPermalink":{"data":{},"fetching":false,"fetched":false,"error":null},"sportGameScheduledDates":{"data":{},"fetching":false,"fetched":false,"error":null},"sportGameInfo":{"data":{},"fetching":false,"fetched":false,"error":null}},"latestnewsReducer":{"data":{"news_programs_title":"รายการข่าว","news_exclusive_title":"Exclusive News","latest_news":[{"id":471186,"ref":361849,"title":"ญาติ “น้องเติมฝัน” ทวงความเป็นธรรม ครบ 100 วันยังไร้เยียวยา “ลุงเดช” วางเงิน 3 หมื่น อ้างมีเงินเท่านี้","content":"\u003cp\u003e\u003cb\u003eญาติ “น้องเติมฝัน” ถือป้ายทวงความเป็นธรรม ครบ 100 วันยังไร้เยียวยา “ลุงเดช” อดีตผู้ช่วยผู้ใหญ่บ้าน วางเงิน 3 หมื่น อ้างมีเงินเท่านี้ ศาลนัดฟังคำพิพากษา 23 พ.ย.นี้\u003cbr\u003e\u003c/b\u003e\u003cbr\u003eญาติของ “พ่อดุ๊ก-แม่เมย์” ครอบครัวของน้องเติมฝัน เด็กวัย 2 ขวบที่เสียชีวิตจากอุบัติเหตุเมาแล้วขับเมื่อวันที่ 8 มิ.ย. 2569 พร้อมญาติของนายมานิตย์ เจ้าของรถเก๋งโตโยต้าวีออสสีขาว และเจ้าของรถกระบะอีซูซุสีบรอนซ์ทอง เดินทางมาที่ศาลจังหวัดลำปาง เพื่อให้กำลังใจครอบครัวผู้เสียหายและถือป้ายเรียกร้องความเป็นธรรม โดยมีข้อความว่า “ไร้การเยียวยา” และ “ตายแล้ว 100 วัน แต่ยังไม่ได้รับเงินเยียวยา” หลังการเจรจาไกล่เกลี่ยยังไม่สามารถตกลงกันได้\u003cbr\u003e\u003cbr\u003eสำหรับคดีนี้ จำเลยซึ่งเป็นอดีตผู้ช่วยผู้ใหญ่บ้าน หรือที่รู้จักกันในชื่อ “ลุงเดช” เดินทางมาพร้อมทนายความ ขณะที่ครอบครัวผู้เสียหายมีนายกมล ถาน้อย ทนายความอาสา เดินทางมาร่วมดำเนินการในคดี โดยก่อนหน้านี้จำเลยได้นำเงินจำนวน 30,000 บาท มาวางไว้ที่ศาลตั้งแต่ช่วงต้นเดือนกันยายน แต่ในตอนแรกไม่ได้ระบุว่าจะมอบให้ผู้เสียหายรายใด ต่อมาเมื่อมีการสอบถามจำเลยแจ้งว่าจะมอบเงินดังกล่าวให้เฉพาะพ่อดุ๊ก แม่เมย์เพื่อเยียวยาศพน้องเติมฝัน พร้อมระบุว่าตัวเองมีเงินเพียงเท่านี้ ไม่สามารถหาเงินมาเพิ่มเติมได้\u003cbr\u003e\u003cbr\u003eมีรายงานว่าปัจจุบันจำเลยมีรายได้ประมาณเดือนละ 6,000 บาท จากการรับจ้างเก็บค่าน้ำประปา ขณะที่ผู้เสียหายรายอื่น ได้แก่ นายมานิตย์ เจ้าของรถเก๋งวีออสสีขาว และเจ้าของรถกระบะอีซูซุสีบรอนซ์ทอง ระบุว่ายังไม่ได้รับเงินเยียวยาเช่นกัน\u003cbr\u003e\u003cbr\u003eทนายความอาสา เปิดเผยว่า วันนี้คดีแพ่งได้ดำเนินกระบวนการสืบพยาน โดยแม่เมย์เรียกค่าเสียหายเป็นเงิน 12 ล้านบาท ส่วนคดีอาญาจำเลยให้การรับสารภาพ และขณะนี้อยู่ในกระบวนการพิจารณาของศาล ทั้งนี้ยังมีผู้เสียหายรายอื่นอีก 3 รายที่เกี่ยวข้องกับคดี\u003cbr\u003e\u003cbr\u003eด้านครอบครัวน้องเติมฝันเปิดเผยความรู้สึกว่า รู้สึกเสียใจและหมดกำลังใจ หลังจำเลยระบุว่ามีเงินเพียง 30,000 บาท และไม่สามารถชดใช้เพิ่มเติมได้ ทำให้ครอบครัวไม่คาดหวังว่าจะได้รับเงินเยียวยาอีก อย่างไรก็ตาม ยังคงเดินหน้าติดตามกระบวนการยุติธรรมต่อไป\u003cbr\u003e\u003cbr\u003eทั้งนี้ ศาลจังหวัดลำปางกำหนดนัดฟังคำพิพากษาทั้งคดีแพ่งและคดีอาญา ในวันที่ 23 พ.ย. 2569 เวลา 09.00 น.\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e","thumb":"https://assets.ch3plus.com/newsch/2026/09/613709171460.jpg","count":54,"date":"2026-09-21T20:22:00+07:00","author":"chutikan_o@becworld.com","available":"","category_id":63,"category":"สังคม","category_permalink":"social","program_id":13,"program":"เรื่องเล่าเช้านี้","program_permalink":"morning","video_id":"","stream":"","stream_svod":"","duration":0,"keyword":"น้องเติมฝัน, ทวงความเป็นธรรม, ไร้เยียวยา, ลุงเดช"},{"id":471185,"ref":361848,"title":"รวบแล้วหนุ่มสะเดาะกุญแจมือตำรวจ หลบหนีขณะกำลังนำตัวฝากขังศาล","content":"\u003cp\u003e\u003cb\u003eรวบแล้ว หนุ่มสะเดาะกุญแจมือตำรวจ หนีจากหน้าห้องศาลจังหวัดเกาะสมุย เดินเท้าบนภูเขาร่วม 6 วัน ไกล 20 กม. จนมาถึงบ้านตัวเอง ก่อนถูกรวบในสภาพอิดโรย เจ้าตัวอ้างกุญแจมือหลุดจึงสบโอกาสหลบหนี ตร.แจ้งข้อกล่าวหาหลบหนีระหว่างการควบคุมขัง\u003cbr\u003e\u003c/b\u003e\u003cbr\u003eวันที่ 21 ก.ย. 2569 ผู้สื่อข่าวรายงานว่า เจ้าหน้าที่ตำรวจ สภ.บ่อผุด ทั้งในและนอกเครื่องแบบ พร้อมด้วยกำลังเจ้าหน้าที่ฝ่ายปกครองอำเภอเกาะสมุย และ อาสามัคร ร่วมกว่า 50 นาย กระจายกำลังกันออกค้นหา นายเต๋า อายุ 26 ปี ผู้ต้องหาที่สะเดาะกุญแจมือเจ้าหน้าที่ตำรวจ หลบหนีไปที่บริเวณหน้าห้องขังของศาลจังหวัดเกาะสมุยได้แล้ว หลังทางเจ้าหน้าที่ได้ติดตามผู้ต้องหารายนี้อย่างต่อเนื่องตั้งวันที่ 16 ก.ย.ที่ผ่านมา\u003cbr\u003e\u003cbr\u003eก่อนจับกุม ทางเจ้าหน้าที่ได้ระดมกำลังกันออกค้นหาทั้งบนภูเขาและบ้านเรือนของชาวบ้านที่ได้รับแจ้งเบาะแสตลอดเวลา 6 วัน จนในที่สุด วันนี้ (21 ก.ย. 2569) เจ้าหน้าที่ตำรวจนำโดย พ.ต.ท.บุญเชิด มีชัย สวป.สภ.บ่อผุด พร้อมกำลังเจ้าหน้าที่ได้ปิดล้อมตรวจค้นบนเขาพระ หมู่ 1 ต.บ่อผุด อ.เกาะสมุย ซึ่งอยู่ใกล้บ้านของนายเต๋า ผู้ต้องที่ทำร้ายร่างกายผู้อื่นจนได้รับบาดเจ็บ และเจ้าหน้าที่ตำรวจ สภ.บ่อผุด จับกุม ดำเนินคดีในข้อกล่าวหาทำร้ายร่างกายผู้อื่นได้รับบาดเจ็บ พร้อมควบคุมตัวเพื่อฝากขังต่อศาลจังหวัดเกาะสมุย แต่ผู้ต้องหา ได้สะเดาะกุญแจมือของเจ้าหน้าที่ตำรวจหลบหนีไป ตามที่ได้นำเสนอข่าวมาก่อนหน้านี้ และทางเจ้าหน้าที่ได้ออกติดตามมาอย่างต่อเนื่อง\u003cbr\u003e\u003cbr\u003eภายหลังที่ทางเจ้าหน้าที่ได้รับแจ้งเบาะแสว่าพบเห็นผู้ต้องหาเดินอยู่ริมป่าละเมาะ ใกล้บ้านของผู้ต้องหา เมื่อคืนที่ผ่านมา แต่เมื่อเจ้าหน้าที่ตำรวจไปถึงบ้านก็ไม่พบตัว นายเต๋าแต่อย่างใด มีแต่คนในครอบครัวอยู่ที่บ้าน คาดว่านายเต๋า คงได้ยินเสียงสุนัขเห่า จึงได้วิ่งหลบหนี้ขึ้นไปอยู่บนเขาอีกครั้ง จนเช้าวันนี้ทางเจ้าหน้าที่ได้ระดมกำลังกันปิดล้อมค้นหาบนเขาพระ อีกครั้งซึ่งอยู่ใกล้ซอยอิสานพัฒนา บ้านของผู้ต้องหา จนกระทั้งเจอตัวนายเต๋า หลบซ่อนตัวอยู่ริมป่าและสามารถจับกุมตัวได้ในที่สุด ในสภาพอิดโรย\u003cbr\u003e\u003cbr\u003eขณะที่ตัวของนายเต๋า หลังถูกจับกุมยังพูดจาวกวน บอกแค่เพียงว่า ในวันที่หลบหนี กุญแจมือที่เจ้าหน้าที่ตำรวจที่ใส่มาเกิดหลุด จึงสบโอกาสตำรวจเปิดประตูรถควบคุมขังจึงได้วิ่งหลบหนี และได้เดินเท้าบนภูเขากลับมาที่บ้าน ในตลอดระยะเวลา 6 วันที่ผ่านมา เมื่อย้อนดูเส้นทางการหลบหนีของผู้ต้องหารายนี้ จากข้อมูลของทางด้าน พ.ต.ท.บุญเชิด มีชัย สวป.สภ.ย่อผุด ให้ข้อมูลว่า หลังจากผู้ต้องรายนี้หลบหนีการควบคุม ทางเจ้าหน้าที่ก็ได้ระดมกำลังกันออกค้นหากันอย่างต่อเนื่อง พบว่าผู้ต้องหาจะซ่อนตัวส่วนใหญ่อยู่บนเขา แต่ก็จะลงมา แอบขโมยเสื้อผ้า รวมทั้งหาของกิน และน้ำดื่ม ตามบ้านของชาวบ้านที่อยู่ริมภูเขา ก่อนจะกลับขึ้นไปบนภูเขา\u003cbr\u003e\u003cbr\u003eชาวบ้านพบเห็นและแจ้งเบาะแสมาให้เจ้าหน้าที่ ก็ได้ติดตามตรวจค้นทั้งบนภูเขา และตามบ้านร้างริมภูเขาอย่างต่อเนื่อง นอกจากนี้ทางแม่ของนายเต๋าก็ยังใช้เครื่องขยายเสียงจากรถเจ้าหน้าที่ พูดกล่อมให้ลูกชายลงมาจากภูเขาเพื่อมามอบตัวกับเจ้าหน้าที่ แต่นายเต๋าก็ยังไม่ยอมลงมา โดยยังใช้พื้นที่บนภูเขาในซ่อนตัว และใช้เส้นทางเดินเท้าผ่านป่า และเส้นทางเดินเท้าของชาวบ้าน ที่ทำส่วนผลไม้ เดินข้ามภูเขามาถึง 4 ลูก ระยะทางจากจุดที่หลบหนี จนมาถึงบ้านร่วมระยะทางประมาณ 20 กิโลเมตร จนมาถึงจุดที่ใกล้บ้าน จนทางเจ้าหน้าที่สามารถจับกุมตัวได้ในที่สุด ทางเจ้าหน้าที่แจ้งข้อกล่าวหาหลบหนีระหว่างการควบคุมขัง และข้อหาเก่าทำร้ายร่างกายผู้อื่นได้รับบาดเจ็บ\u003cbr\u003e\u003cbr\u003e\u003c/p\u003e","thumb":"https://assets.ch3plus.com/newsch/2026/09/041245652078.jpg","count":34,"date":"2026-09-21T19:09:51+07:00","author":"chutikan_o@becworld.com","available":"","category_id":63,"category":"สังคม","category_permalink":"social","program_id":13,"program":"เรื่องเล่าเช้านี้","program_permalink":"morning","video_id":"","stream":"","stream_svod":"","duration":0,"keyword":"หนุ่มสะเดาะกุญแจมือ, เกาะสมุย"},{"id":471184,"ref":361847,"title":"สื่อสหรัฐฯ ฟ้องรัฐบาลทรัมป์ หลังห้ามนักข่าวเข้าทำเนียบขาว","content":"\u003cp\u003e\u003cb\u003eสำนักข่าว CNN-MS NOW-POLITICO ประกาศยื่นฟ้องรัฐบาลของ “ท